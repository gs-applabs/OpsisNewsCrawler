<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OpsisNewsCrawler.OpsisPlugin/OpsisNewsCrawler.OpsisPlugin.csproj" />
    <ProjectReference Include="../../src/OpsisNewsCrawler.Windows/OpsisNewsCrawler.Windows.csproj" />
    <ProjectReference Include="../../src/OpsisNewsCrawler.Core/OpsisNewsCrawler.Core.csproj" />
    <ProjectReference Include="../../src/OpsisNewsCrawler.Plugin.Abstractions/OpsisNewsCrawler.Plugin.Abstractions.csproj" />
    <None Include="reference/*.txt;reference/*.sha256;reference/*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Like the app and the plugin: the contract DLL next to the tests is the canonical copy (a Release build of the project reference has another SHA-256). -->
  <Target Name="UseCanonicalContract" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)reference\OpsisNewsCrawler.Plugin.Abstractions.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
