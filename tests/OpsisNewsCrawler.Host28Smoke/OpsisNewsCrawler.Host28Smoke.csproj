<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    
    <Reference Include="Opsis.UI">
      <HintPath>../../libs/Opsis.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- Canonical ABI 1.0.0.0 DLL byte-identical to Opsis 2.8.0.2510; do not build a parallel contract into the plugin payload. -->
  <ItemGroup><Reference Include="OpsisNewsCrawler.Plugin.Abstractions"><HintPath>../../libs/OpsisNewsCrawler.Plugin.Abstractions.dll</HintPath><Private>true</Private></Reference></ItemGroup>
</Project>
