<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWindowsForms>true</UseWindowsForms><ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>OpsisNewsCrawler</AssemblyName><ApplicationIcon>..\OpsisNewsCrawler.Windows\Assets\app.ico</ApplicationIcon><Product>Opsis News Crawler</Product><Version>0.25.0</Version></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\OpsisNewsCrawler.Core\OpsisNewsCrawler.Core.csproj" /><ProjectReference Include="..\OpsisNewsCrawler.Windows\OpsisNewsCrawler.Windows.csproj" /></ItemGroup>
  <ItemGroup><Reference Include="Opsis.UI"><HintPath>..\..\libs\Opsis.UI.dll</HintPath><Private>true</Private></Reference></ItemGroup>
  <!-- The contract DLL that ships next to this program is ALWAYS the canonical copy (same SHA-256 as Opsis\libs): see ContractCopiesTests and tools\check-contract-sha.ps1. -->
  <Target Name="UseCanonicalContract" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\tests\OpsisNewsCrawler.Plugin.Tests\reference\OpsisNewsCrawler.Plugin.Abstractions.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
