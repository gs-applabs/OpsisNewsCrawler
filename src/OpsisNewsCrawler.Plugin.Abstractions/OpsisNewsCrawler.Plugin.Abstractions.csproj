<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.30.0</Version>
    <!-- Source mirror only. Apps/plugins must reference the binary from libs/,
         pinned to the actual Opsis 2.8 release and not this separate build. -->
    <!-- Contract ABI version 1.0.0.0: deploy the same binary to Opsis and all plugins before enabling new feeds. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

</Project>
