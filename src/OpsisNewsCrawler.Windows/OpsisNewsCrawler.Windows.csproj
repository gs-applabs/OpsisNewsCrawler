<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net11.0-windows10.0.19041.0</TargetFramework><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>0.30.1</Version><NoWarn>$(NoWarn);WFO1000</NoWarn></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\app.ico" LogicalName="OpsisNewsCrawler.app.ico" /><EmbeddedResource Include="../../LICENSE" LogicalName="OpsisNewsCrawler.LICENSE" /></ItemGroup>
  <ItemGroup><ProjectReference Include="..\OpsisNewsCrawler.Core\OpsisNewsCrawler.Core.csproj" /></ItemGroup>
  <!-- Shared controls: built from ..\Opsis.UI (sibling repository) (see libs\README.md); the DLL is committed so a clone builds on its own. -->
  <ItemGroup><Reference Include="Opsis.UI"><HintPath>..\..\libs\Opsis.UI.dll</HintPath><Private>true</Private></Reference></ItemGroup>
  <ItemGroup><Using Include="Opsis.UI" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OpsisNewsCrawler.Plugin.Tests" /></ItemGroup>
  <!-- Canonical ABI 1.0.0.0 DLL byte-identical to Opsis 2.8.0.2510; do not build a parallel contract into the plugin payload. -->
  <ItemGroup><Reference Include="OpsisNewsCrawler.Plugin.Abstractions"><HintPath>..\..\libs\OpsisNewsCrawler.Plugin.Abstractions.dll</HintPath><Private>true</Private></Reference></ItemGroup>
</Project>
