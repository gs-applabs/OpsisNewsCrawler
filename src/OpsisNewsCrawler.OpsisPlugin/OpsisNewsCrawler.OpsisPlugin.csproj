<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net11.0-windows10.0.19041.0</TargetFramework><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>OpsisNewsCrawler.OpsisPlugin</AssemblyName><Product>Opsis News Crawler</Product><Version>0.30.1</Version><AssemblyVersion>1.0.0.0</AssemblyVersion><FileVersion>1.0.0.0</FileVersion></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\OpsisNewsCrawler.Core\OpsisNewsCrawler.Core.csproj" /><ProjectReference Include="..\OpsisNewsCrawler.Windows\OpsisNewsCrawler.Windows.csproj" /></ItemGroup>
  <ItemGroup><Reference Include="Opsis.UI"><HintPath>..\..\libs\Opsis.UI.dll</HintPath><Private>true</Private></Reference></ItemGroup>
  <!-- Canonical ABI 1.0.0.0 DLL byte-identical to Opsis 2.8.0.2510; do not build a parallel contract into the plugin payload. -->
  <ItemGroup><Reference Include="OpsisNewsCrawler.Plugin.Abstractions"><HintPath>..\..\libs\OpsisNewsCrawler.Plugin.Abstractions.dll</HintPath><Private>true</Private></Reference></ItemGroup>
  <!-- Opsis 3.0 shows this declaration (not a sandbox) next to the plugin: network = feeds, prices, weather and live-video embeds; audio = the optional live video (muted by default); localFiles = settings, caches, digests and exports in the user profile. Older hosts ignore the file. -->
  <ItemGroup><None Include="opsis-permissions.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
